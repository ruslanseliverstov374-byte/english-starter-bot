# Пример настроек. Скопируйте в .env (или задайте переменные окружения).
# Обязательно только BOT_TOKEN.

# Токен бота от @BotFather
BOT_TOKEN=8123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Где хранить прогресс (SQLite). По умолчанию data/bot.db рядом с bot.py
DB_PATH=data/bot.db

# Только для облака: публичный HTTPS-адрес сервиса.
# Если задан - бот работает через webhook, иначе через long polling.
# WEBHOOK_URL=https://my-bot.onrender.com
# WEBHOOK_SECRET=pristan-sluchaynyy-parol
# PORT=8080
