@echo off
chcp 65001 >nul
cd /d "%~dp0"

echo ============================================================
echo   ПИНГ ОБЛАЧНОГО БОТА (чтобы не засыпал)
echo ============================================================
echo.
echo Бесплатный Render засыпает через 15 минут без запросов.
echo Этот скрипт ставит задачу: каждые 5 минут дергать /health,
echo чтобы бот отвечал мгновенно и присылал напоминания вовремя.
echo.
echo Ничего регистрировать не нужно. Работает, пока компьютер включён.
echo.

where python >nul 2>nul
if errorlevel 1 (
